# Copy this file to .env and fill in real values for local testing.
# On Railway, set these as environment variables in the project settings —
# there is no .env file on the server.

# Required — from console.anthropic.com. This is your own key; usage is
# billed to your own Anthropic account.
ANTHROPIC_API_KEY=

# Required — from @BotFather on Telegram after creating your bot.
TELEGRAM_BOT_TOKEN=

# Required — your company's name, inserted into the bot's answers.
COMPANY_NAME=

# Required — your numeric Telegram user ID (message @userinfobot to get
# it). This is the only account allowed to upload documents.
ADMIN_USER_ID=

# Optional — comma-separated Telegram chat IDs the bot will respond in.
# Leave blank to respond in any chat it's added to.
ALLOWED_CHAT_IDS=

# Optional — overrides the default Claude model.
MODEL=

# Optional — DEBUG, INFO, WARNING, or ERROR. Defaults to INFO.
LOG_LEVEL=

# Optional — healthchecks.io (or compatible) ping URL. When set, the bot
# pings it periodically while Telegram polling is healthy, so a silent
# outage gets reported instead of going unnoticed.
HEALTHCHECK_PING_URL=
